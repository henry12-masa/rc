---
import { Image } from "emdash/ui";
import { TIERS, type Game } from "../lib/kits";

interface Props {
	game: Game;
	headingLevel?: 2 | 3;
	/** card: グリッド用。compact: 年表・関連作品用の横長 */
	variant?: "card" | "compact";
}

const { game, headingLevel = 3, variant = "card" } = Astro.props;
const Heading = `h${headingLevel}` as const;
const href = `/kits/${game.slug}`;
const titleId = `game-${variant}-${game.slug}`;
---

<article class:list={["game", `game--${variant}`]} data-era={game.era?.slug}>
	<a href={href} class="game__cover" tabindex="-1" aria-hidden="true">
		{
			game.cover ? (
				<Image image={game.cover as any} sizes="(min-width: 1080px) 280px, 45vw" />
			) : (
				<span class="game__tile">
					<span class="game__tile-year">{game.year}</span>
					<span class="game__tile-title">{game.model || game.grades[0]?.label}</span>
				</span>
			)
		}
	</a>
	<div class="game__body">
		<a href={href} class="game__link" aria-labelledby={titleId}>
			<span class="game__meta">
				<span class="game__year">{game.year}</span>
				<span class:list={["tier", `tier--${game.tier}`]}>{TIERS[game.tier]}</span>
			</span>
			<Heading class="game__title" id={titleId}>{game.title}</Heading>
			{variant === "card" && <p class="game__summary">{game.summary}</p>}
		</a>
		<p class="game__facts">
			{game.grades[0]?.label}
			{game.series[0] && <span> · {game.series[0].label}</span>}
		</p>
	</div>
</article>

<style>
	.game {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
		padding: var(--card-padding);
		background: var(--color-surface);
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-card);
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}

	.game:hover {
		box-shadow: var(--shadow-card-hover);
		transform: translateY(-2px);
	}

	.game__cover {
		display: block;
		aspect-ratio: 4 / 3;
		border-radius: var(--radius-lg);
		overflow: hidden;
	}

	.game__cover :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.game__tile {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		height: 100%;
		padding: var(--spacing-4);
		color: var(--era-ink);
		background:
			repeating-linear-gradient(
				0deg,
				transparent 0 3px,
				color-mix(in oklab, var(--era-ink) 6%, transparent) 3px 4px
			),
			var(--era-bg);
	}

	.game__tile-year {
		font-family: var(--font-mono);
		font-size: 2.25rem;
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.game__tile-title {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		line-height: 1.35;
		opacity: 0.85;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.game__body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
		flex: 1;
	}

	.game__link {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-1-5, 0.375rem);
		color: inherit;
		text-decoration: none;
	}

	/* カード全体をクリック可能にする */
	.game__link::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.game__link:focus-visible {
		outline: none;
	}

	.game__link:focus-visible::after {
		outline: 2px solid var(--color-brand);
		outline-offset: 2px;
	}

	.game__meta {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.game__title {
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-heading);
		line-height: 1.35;
		letter-spacing: -0.01em;
	}

	.game__summary {
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
		line-height: 1.7;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.game__facts {
		margin-top: auto;
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	/* compact: 横並び */
	.game--compact {
		flex-direction: row;
		align-items: center;
		gap: var(--spacing-3);
		padding: var(--spacing-2);
		border-radius: var(--radius-lg);
	}

	.game--compact .game__cover {
		flex: none;
		width: 64px;
		aspect-ratio: 1;
		border-radius: var(--radius);
	}

	.game--compact .game__tile {
		padding: var(--spacing-2);
		justify-content: center;
	}

	.game--compact .game__tile-year {
		font-size: var(--font-size-sm);
	}

	.game--compact .game__tile-title {
		display: none;
	}

	.game--compact .game__title {
		font-size: var(--font-size-base);
	}
</style>
