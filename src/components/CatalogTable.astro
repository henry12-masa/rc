---
import type { CatalogRow } from "../lib/catalog";
import { formatCatalogDate } from "../lib/catalog";
import { amazonCatalogUrl } from "../lib/amazon";

interface Props {
	rows: CatalogRow[];
	/** 年をまたぐ一覧(検索結果)なら発売日に年も出す */
	showYear?: boolean;
	/** 見出し(パーツ名簿では「発売 / 商品名 / 品番」) */
	heads?: [string, string, string];
}

const { rows, showYear = false, heads = ["初出", "車種名", "シャーシ"] } = Astro.props;
---

<p class="ct-pr"><span>PR</span>「Amazon」はAmazonの検索結果へのリンク(広告)です。再販品や中古品が見つかることもあります。限定品にはリンクを付けていません。</p>
<div class="ct-wrap">
	<table class="ct">
		<thead>
			<tr>
				<th scope="col" class="ct__date">{heads[0]}</th>
				<th scope="col">{heads[1]}</th>
				<th scope="col" class="ct__pub">{heads[2]}</th>
				<th scope="col" class="ct__buy"><span class="sr-only">購入</span></th>
			</tr>
		</thead>
		<tbody>
			{
				rows.map(([date, title, publisher, dl, slug]) => {
					const amazon = amazonCatalogUrl(title, dl);
					return (
						<tr data-q={`${title} ${publisher}`.normalize("NFKC").toLowerCase().replace(/\s+/g, "")}>
							<td class="ct__date">
								{showYear && date && <span class="ct__year">{date.slice(0, 4)}年</span>}
								{formatCatalogDate(date)}
							</td>
							<td class="ct__title">
								{slug ? (
									<a href={`/kits/${slug}`} class="ct__link">
										{title}
										<span class="ct__badge">厳選</span>
									</a>
								) : (
									title
								)}
								{dl === 1 && <span class="ct__dl">限定</span>}
							</td>
							<td class="ct__pub">{publisher}</td>
							<td class="ct__buy">
								{amazon && (
									<a href={amazon} rel="sponsored noopener" target="_blank" class="ct__amazon" aria-label={`${title}をAmazonで探す`}>
										Amazon
									</a>
								)}
							</td>
						</tr>
					);
				})
			}
		</tbody>
	</table>
</div>

<style>
	.ct-pr {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		margin-bottom: var(--spacing-3);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.ct-pr span {
		padding: 0 0.35rem;
		border-radius: var(--radius-sm);
		background: var(--color-fill);
		font-family: var(--font-mono);
		font-size: 0.625rem;
	}

	.ct-wrap {
		overflow-x: auto;
		background: var(--color-surface);
		border-radius: var(--radius-lg);
		box-shadow: inset 0 0 0 1px var(--color-border);
	}

	.ct {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--font-size-sm);
	}

	.ct th {
		position: sticky;
		top: 0;
		padding: var(--spacing-3) var(--spacing-4);
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
		font-size: var(--font-size-xs);
		font-weight: 500;
		text-align: left;
		color: var(--color-muted);
	}

	.ct td {
		padding: var(--spacing-2) var(--spacing-4);
		border-bottom: 1px solid var(--color-border);
		vertical-align: top;
	}

	.ct tr:last-child td {
		border-bottom: 0;
	}

	.ct__date {
		width: 6.5rem;
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
		color: var(--color-muted);
	}

	.ct__year {
		display: block;
		font-size: var(--font-size-xs);
	}

	.ct__title {
		word-break: auto-phrase;
	}

	.ct__link {
		font-weight: 600;
		color: var(--color-text);
	}

	.ct__badge,
	.ct__dl {
		display: inline-block;
		margin-left: var(--spacing-2);
		padding: 0 0.4rem;
		border-radius: var(--radius-sm);
		font-size: 0.6875rem;
		font-weight: 500;
		vertical-align: 0.1em;
		white-space: nowrap;
	}

	.ct__badge {
		background: var(--color-brand);
		color: var(--color-on-brand);
	}

	.ct__dl {
		background: var(--color-fill);
		color: var(--color-muted);
	}

	.ct__pub {
		width: 28%;
		color: var(--color-text-secondary);
	}

	.ct__buy {
		width: 5rem;
		text-align: right;
	}

	.ct__amazon {
		font-size: var(--font-size-xs);
		white-space: nowrap;
		color: var(--color-muted);
	}

	.ct__amazon:hover {
		color: var(--color-text);
	}

	@media (max-width: 640px) {
		.ct__pub {
			display: none;
		}

		.ct td,
		.ct th {
			padding-inline: var(--spacing-3);
		}

		.ct__date {
			width: 4.5rem;
		}
	}
</style>
