---
import Base from "../../layouts/Base.astro";
import KitCard from "../../components/KitCard.astro";
import AmazonBox from "../../components/AmazonBox.astro";
import { gradeInfo } from "../../lib/amazon";
import {
	ERAS,
	GRADES,
	SERIES,
	TIERS,
	eraBySlug,
	kitsUrl,
	loadGames,
	sortGames,
	type SortKey,
} from "../../lib/kits";

const { games, cacheHint } = await loadGames();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const q = Astro.url.searchParams;
const filters = {
	era: q.get("era") ?? "",
	grade: q.get("grade") ?? "",
	series: q.get("series") ?? "",
	tier: q.get("tier") ?? "",
	sort: (q.get("sort") ?? "old") as SortKey,
};

const filtered = sortGames(
	games.filter(
		(g) =>
			(!filters.era || g.era?.slug === filters.era) &&
			(!filters.grade || g.grades.some((x) => x.slug === filters.grade)) &&
			(!filters.series || g.series.some((x) => x.slug === filters.series)) &&
			(!filters.tier || g.tier === filters.tier),
	),
	filters.sort,
);

// 年代順のときは年代ごとに見出しで区切る
const grouped =
	filters.sort === "old" || filters.sort === "new"
		? (filters.sort === "new" ? [...ERAS].reverse() : ERAS)
				.map((era) => ({ era, games: filtered.filter((g) => g.era?.slug === era.slug) }))
				.filter((group) => group.games.length > 0)
		: null;

// 選択中の条件の説明(見出し用)
const era = eraBySlug(filters.era);
const hw = filters.grade ? gradeInfo(filters.grade) : null;
const active = [
	era && { key: "era", label: era.label },
	filters.grade && { key: "grade", label: GRADES[filters.grade as keyof typeof GRADES] },
	filters.series && { key: "series", label: SERIES[filters.series as keyof typeof SERIES] },
	filters.tier && { key: "tier", label: TIERS[filters.tier as keyof typeof TIERS] },
].filter(Boolean) as Array<{ key: keyof typeof filters; label: string }>;

const heading = active.length ? active.map((a) => a.label).join(" × ") : "すべてのマシン";

// 現在の絞り込みに対して、ほかの条件で何本あるか(0本の選択肢を薄くする)
function countWith(key: "era" | "grade" | "series" | "tier", value: string) {
	const f = { ...filters, [key]: value };
	return games.filter(
		(g) =>
			(!f.era || g.era?.slug === f.era) &&
			(!f.grade || g.grades.some((x) => x.slug === f.grade)) &&
			(!f.series || g.series.some((x) => x.slug === f.series)) &&
			(!f.tier || g.tier === f.tier),
	).length;
}

const without = (key: string) =>
	kitsUrl({ ...filters, sort: filters.sort === "old" ? undefined : filters.sort, [key]: undefined });
---

<Base
	title={active.length ? `${heading}のタミヤRC` : "マシン一覧"}
	description={era ? era.lead : "1976年のポルシェ934から最新のマシンまで、カテゴリ・シャーシ・年代で絞り込めるタミヤのRCカーの一覧。"}
>
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">Machines</p>
			<h1 class="intro__title">{heading}</h1>
			<p class="intro__lead">
				{era ? era.lead : hw ? hw.desc : "カテゴリ・シャーシ・年代を組み合わせて、次に組む1台を探してください。"}
			</p>
			{
				hw && (
					<div class="hw-box">
						<p class="hw-box__meta">
							{hw.scale} · {hw.since}年から · <a href={`/chassis#${filters.grade}`}>シャーシガイドで見る</a> · <a href={`/catalog/${filters.grade}`}>全車種名簿</a>
						</p>
						{hw.amazon && <AmazonBox title="このカテゴリをAmazonで探す" links={[hw.amazon]} compact />}
					</div>
				)
			}
		</div>
	</header>

	<section class="band section">
		<div class="frame">
			<form method="get" action="/kits" class="filters" aria-label="絞り込み">
				<label>
					<span>年代</span>
					<select name="era">
						<option value="">すべて</option>
						{ERAS.map((e) => (
							<option value={e.slug} selected={filters.era === e.slug}>
								{e.label}({countWith("era", e.slug)})
							</option>
						))}
					</select>
				</label>
				<label>
					<span>カテゴリ</span>
					<select name="grade">
						<option value="">すべて</option>
						{Object.entries(GRADES).map(([slug, label]) => {
							const n = countWith("grade", slug);
							return (
								<option value={slug} selected={filters.grade === slug} disabled={n === 0 && filters.grade !== slug}>
									{label}({n})
								</option>
							);
						})}
					</select>
				</label>
				<label>
					<span>シャーシ</span>
					<select name="series">
						<option value="">すべて</option>
						{Object.entries(SERIES).map(([slug, label]) => {
							const n = countWith("series", slug);
							return (
								<option value={slug} selected={filters.series === slug} disabled={n === 0 && filters.series !== slug}>
									{label}({n})
								</option>
							);
						})}
					</select>
				</label>
				<label>
					<span>推し度</span>
					<select name="tier">
						<option value="">すべて</option>
						{Object.entries(TIERS).map(([slug, label]) => (
							<option value={slug} selected={filters.tier === slug}>
								{label}({countWith("tier", slug)})
							</option>
						))}
					</select>
				</label>
				<label>
					<span>並び順</span>
					<select name="sort">
						<option value="old" selected={filters.sort === "old"}>古い順</option>
						<option value="new" selected={filters.sort === "new"}>新しい順</option>
						<option value="tier" selected={filters.sort === "tier"}>推し度順</option>
						<option value="title" selected={filters.sort === "title"}>車種名順</option>
					</select>
				</label>
				<button type="submit" class="btn">絞り込む</button>
			</form>

			<div class="result-bar">
				<p class="result-count"><strong>{filtered.length}</strong> 台</p>
				{
					active.length > 0 && (
						<ul class="chips active-filters">
							{active.map((a) => (
								<li>
									<a href={without(a.key)} class="chip" aria-label={`${a.label}の条件を外す`}>
										{a.label} ×
									</a>
								</li>
							))}
							<li><a href="/kits" class="clear">すべて解除</a></li>
						</ul>
					)
				}
			</div>

			{
				filtered.length === 0 ? (
					<div class="empty-state">
						<h2 class="empty-state__title">該当するマシンがありません</h2>
						<p class="empty-state__text">条件をひとつ外してみてください。</p>
						<div class="empty-state__actions">
							<a href="/kits" class="btn">条件をリセット</a>
						</div>
					</div>
				) : grouped ? (
					grouped.map(({ era: groupEra, games: list }) => (
						<section class="era-group" aria-labelledby={`era-${groupEra.slug}`}>
							<h2 id={`era-${groupEra.slug}`} class="era-group__title" data-era={groupEra.slug}>
								<span class="era-group__swatch" aria-hidden="true" />
								{groupEra.label}
								<span class="era-group__count">{list.length}台</span>
							</h2>
							<div class="game-grid">
								{list.map((game) => <KitCard game={game} headingLevel={3} />)}
							</div>
						</section>
					))
				) : (
					<div class="game-grid">
						{filtered.map((game) => <KitCard game={game} headingLevel={2} />)}
					</div>
				)
			}
		</div>
	</section>
</Base>

<script>
	// JSが有効なら、選択を変えた時点で絞り込む(ボタンなしでも使える)
	const form = document.querySelector<HTMLFormElement>(".filters");
	form?.addEventListener("change", () => {
		const data = new FormData(form);
		const params = new URLSearchParams();
		for (const [k, v] of data) if (v && !(k === "sort" && v === "old")) params.set(k, String(v));
		const qs = params.toString();
		location.href = qs ? `/kits?${qs}` : "/kits";
	});
</script>

<style>
	.hw-box {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
		margin-top: var(--spacing-5);
		max-width: 640px;
	}

	.hw-box__meta {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.filters {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr)) auto;
		align-items: end;
		gap: var(--spacing-3);
		padding: var(--spacing-4);
		background: var(--color-surface);
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-card);
	}

	.filters label {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-1);
		min-width: 0;
	}

	.filters label > span {
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-muted);
	}

	.filters select {
		width: 100%;
		min-height: 2.5rem;
		padding: 0 var(--spacing-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg);
		color: var(--color-text);
		font: inherit;
		font-size: var(--font-size-sm);
	}

	.filters select:focus-visible {
		outline: 2px solid var(--color-brand);
		outline-offset: 1px;
	}

	.result-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-3);
		margin-block: var(--spacing-6);
	}

	.result-count {
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}

	.result-count strong {
		font-family: var(--font-mono);
		font-size: var(--font-size-xl);
		color: var(--color-text);
	}

	.active-filters {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-2);
	}

	.clear {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.era-group + .era-group {
		margin-top: var(--spacing-12);
	}

	.era-group__title {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		margin-bottom: var(--spacing-5);
		font-size: var(--font-size-xl);
	}

	.era-group__swatch {
		width: 14px;
		height: 14px;
		border-radius: 4px;
		background: var(--era-bg);
		box-shadow: inset 0 0 0 3px var(--era-ink);
	}

	.era-group__count {
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		font-weight: 400;
		color: var(--color-muted);
	}

	@media (max-width: 960px) {
		.filters {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.filters {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
