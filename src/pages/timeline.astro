---
import Base from "../layouts/Base.astro";
import { ERAS, TIERS, kitsUrl, loadGames } from "../lib/kits";

const { games, cacheHint } = await loadGames();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const essentialOnly = Astro.url.searchParams.get("tier") === "essential";
const shown = essentialOnly ? games.filter((g) => g.tier === "essential") : games;

// 年代 → 年 → 作品
const eras = ERAS.map((era) => {
	const inEra = shown.filter((g) => g.era?.slug === era.slug);
	const years = [...new Set(inEra.map((g) => g.year))].map((year) => ({
		year,
		games: inEra.filter((g) => g.year === year),
	}));
	return { era, years, count: inEra.length };
}).filter((e) => e.count > 0);
---

<Base title="年表" description="1976年の最初のタミヤRCカーから現在まで、掲載マシンを発売年順に並べたタミヤRC史の年表。">
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">Timeline</p>
			<h1 class="intro__title">年表</h1>
			<p class="intro__lead">
				掲載マシンを発売の年で並べました。同じ年に何が出ていたかを見ると、新しいシャーシの登場やブームの流れが見えてきます。
			</p>
			<div class="toggle" role="group" aria-label="表示するマシン">
				<a href="/timeline" class:list={["btn btn--sm", essentialOnly && "btn--ghost"]} aria-current={!essentialOnly ? "page" : undefined}>
					すべて({games.length})
				</a>
				<a href="/timeline?tier=essential" class:list={["btn btn--sm", !essentialOnly && "btn--ghost"]} aria-current={essentialOnly ? "page" : undefined}>
					定番のみ({games.filter((g) => g.tier === "essential").length})
				</a>
			</div>
		</div>
	</header>

	<nav class="band era-nav" aria-label="年代へ移動">
		<div class="frame">
			<ul>
				{eras.map(({ era }) => (
					<li data-era={era.slug}>
						<a href={`#${era.slug}`}><span class="dot" aria-hidden="true" />{era.short}</a>
					</li>
				))}
			</ul>
		</div>
	</nav>

	{
		eras.map(({ era, years, count }) => (
			<section class="band section" id={era.slug} data-era={era.slug} aria-labelledby={`h-${era.slug}`}>
				<div class="frame">
					<div class="era-head">
						<h2 id={`h-${era.slug}`}>{era.label}</h2>
						<a href={kitsUrl({ era: era.slug })} class="arrow-link">{count}台をカードで見る →</a>
					</div>
					<p class="era-lead">{era.lead}</p>
					<ol class="years">
						{years.map(({ year, games: list }) => (
							<li class="year" id={`y${year}`}>
								<span class="year__label">{year}</span>
								<ul class="year__games">
									{list.map((g) => (
										<li>
											<a href={`/kits/${g.slug}`}>
												<span class="title">{g.title}</span>
												<span class:list={["tier", `tier--${g.tier}`]}>{TIERS[g.tier]}</span>
											</a>
											<span class="meta">
												{g.grades[0]?.label} · {g.series[0]?.label}
											</span>
										</li>
									))}
								</ul>
							</li>
						))}
					</ol>
				</div>
			</section>
		))
	}
</Base>

<style>
	.toggle {
		display: flex;
		gap: var(--spacing-2);
		margin-top: var(--spacing-6);
	}

	.era-nav {
		position: sticky;
		top: var(--header-height, var(--nav-height));
		z-index: 5;
		background: color-mix(in oklab, var(--color-bg) 88%, transparent);
		backdrop-filter: blur(8px);
	}

	.era-nav ul {
		list-style: none;
		display: flex;
		gap: var(--spacing-1);
		padding-block: var(--spacing-3);
		overflow-x: auto;
		scrollbar-width: none;
	}

	.era-nav a {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-2);
		padding: var(--spacing-1) var(--spacing-3);
		border-radius: var(--radius-full);
		font-size: var(--font-size-sm);
		white-space: nowrap;
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.era-nav a:hover {
		background: var(--color-surface);
		color: var(--color-text);
	}

	.dot {
		width: 10px;
		height: 10px;
		border-radius: 3px;
		background: var(--era-bg);
		box-shadow: inset 0 0 0 2px var(--era-ink);
	}

	section[id] {
		scroll-margin-top: calc(var(--header-height, var(--nav-height)) + 56px);
	}

	.era-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--spacing-3);
	}

	.era-head h2 {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-3);
		font-size: var(--font-size-2xl);
	}

	.era-head h2::before {
		content: "";
		width: 18px;
		height: 18px;
		border-radius: 5px;
		background: var(--era-bg);
		box-shadow: inset 0 0 0 4px var(--era-ink);
	}

	.era-lead {
		margin-top: var(--spacing-2);
		margin-bottom: var(--spacing-6);
		max-width: 60ch;
		color: var(--color-text-secondary);
	}

	.years {
		list-style: none;
		border-inline-start: 2px solid var(--color-border);
		margin-inline-start: 1.75rem;
	}

	.year {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		padding: var(--spacing-3) 0 var(--spacing-3) 2.75rem;
		scroll-margin-top: calc(var(--header-height, var(--nav-height)) + 64px);
	}

	.year:target .year__label {
		background: var(--color-brand);
		color: var(--color-on-brand);
	}

	.year__label {
		position: absolute;
		inset-inline-start: -1px;
		top: var(--spacing-4);
		translate: -50% 0;
		padding: 0.1rem 0.4rem;
		border-radius: var(--radius-sm);
		background: var(--color-bg);
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-text);
	}

	.year__games {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: var(--spacing-2) var(--spacing-6);
	}

	.year__games li {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: var(--spacing-2) var(--spacing-3);
		background: var(--color-surface);
		border-radius: var(--radius);
		box-shadow: inset 0 0 0 1px var(--color-border-subtle);
	}

	.year__games a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-2);
		color: var(--color-text);
		text-decoration: none;
		font-weight: 500;
	}

	.year__games a:hover .title {
		color: var(--color-brand);
	}

	.tier {
		flex: none;
		font-size: 0.6875rem;
	}

	.meta {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}
</style>
