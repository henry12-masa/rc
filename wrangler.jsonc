{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rc-curation",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rc-curation",
			"database_id": "d091a0c4-cfe0-49b5-8fc8-8504ce19c910",
		},
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "8b83164a74e34da2964cac223dcc0b30",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "rc-curation-media",
		},
	],
	"routes": [{ "pattern": "rc.napoblog.com", "custom_domain": true }],
	"triggers": {
		"crons": ["* * * * *"],
	},
}
